              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"What is the formula for the capacitance of a parallel plate capacitor?\"\n        }\n      ]\n    }\n  ],\n  \"filters\": {\n    \"subject\": \"Physics\",\n    \"difficulty\": \"Medium\",\n    \"timePeriod\": \"Last 5 years (2020 - 2024)\"\n  }\n}"
