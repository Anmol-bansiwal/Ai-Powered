DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/edusearch_ai?schema=public"
PORT=3000
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Deployed frontend origins only (localhost is always allowed automatically).
# Example: https://app.example.com,https://staging.example.com
CORS_ORIGINS=

# Paper PDF / figure storage. auto = Cloudinary when credentials are set.
# Later: client uploads to S3 and Nest only stores the returned URL (STORAGE_PROVIDER=s3).
STORAGE_PROVIDER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Experimental: let the model route a chat's first message when the rules
# cannot classify it. Leave false in production until evaluated.
CHAT_FIRST_TURN_DECISION=false
